@model ProjectFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit partner search" : "Publish a partner search";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<div class="card" style="max-width: 860px;">
    <div class="card-body">
        @* The hidden Id field is what binds the action's "id" parameter on edit. *@
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Summary" class="form-label"></label>
                <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Summary" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Details" class="form-label"></label>
                <textarea asp-for="Details" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Details" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="ActionType" class="form-label"></label>
                    <select asp-for="ActionType" class="form-select">
                        @foreach (var action in Enum.GetValues<ActionType>())
                        {
                            <option value="@action">@action.Label()</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Sector" class="form-label"></label>
                    <select asp-for="Sector" class="form-select">
                        @foreach (var sector in EnumFlags.SingleValues<Sector>())
                        {
                            <option value="@sector">@sector.Label()</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-label">Priorities (choose one or two)</div>
                @foreach (var priority in EnumFlags.SingleValues<Priority>())
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="Priorities" id="priority-@priority" value="@priority" checked="@Model.Priorities.Contains(priority)" />
                        <label class="form-check-label" for="priority-@priority">@priority.Label()</label>
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label" for="TargetCountries">Partner countries</label>
                <select name="TargetCountries" id="TargetCountries" class="form-select" multiple size="8">
                    @foreach (var country in Countries.All)
                    {
                        <option value="@country" selected="@Model.TargetCountries.Contains(country)">@country</option>
                    }
                </select>
                <div class="form-text">Hold Ctrl (Cmd on Mac) to select several. Leave empty to accept partners from any Erasmus+ country.</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="PartnerSearchEnd" class="form-label"></label>
                    <input asp-for="PartnerSearchEnd" type="date" class="form-control" />
                    <span asp-validation-for="PartnerSearchEnd" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProjectDeadline" class="form-label"></label>
                    <input asp-for="ProjectDeadline" type="date" class="form-control" />
                    <span asp-validation-for="ProjectDeadline" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="PartnerRole" class="form-label"></label>
                <input asp-for="PartnerRole" class="form-control" placeholder="e.g. send 5 participants and host a local workshop" />
                <span asp-validation-for="PartnerRole" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BudgetNote" class="form-label"></label>
                <input asp-for="BudgetNote" class="form-control" />
                <div class="form-text">Optional: you do not have to publish budget details.</div>
                <span asp-validation-for="BudgetNote" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" asp-action="Mine">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
