@model ChatRoomViewModel
@{
    ViewData["Title"] = "Chat with " + Model.Other.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Chat with
            <a asp-controller="Organizations" asp-action="Details" asp-route-id="@Model.Other.Id" class="text-decoration-none">@Model.Other.Name</a>
        </h1>
        <div class="text-secondary small">
            Project: <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Application.ProjectId">@Model.Application.Project!.Title</a>
            &middot; <span class="badge text-bg-secondary">@Model.Application.Status</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanComplete)
        {
            <form asp-controller="Applications" asp-action="Complete" method="post"
                  onsubmit="return confirm('Mark this partnership as completed? The chat becomes read-only and both sides can leave a review.');">
                <input type="hidden" name="id" value="@Model.Application.Id" />
                <button type="submit" class="btn btn-outline-success">Mark as completed</button>
            </form>
        }
        @if (Model.CanReview)
        {
            <a class="btn btn-warning" asp-controller="Reviews" asp-action="Create" asp-route-id="@Model.Application.Id">Leave a review</a>
        }
    </div>
</div>

<div id="messages" class="chat-box mb-2">
    @foreach (var message in Model.Messages)
    {
        var mine = message.SenderOrganizationId == Model.Me.Id;
        <div class="chat-message @(mine ? "mine" : "theirs")">
            <div class="chat-meta">@message.Sender!.Name - <span data-utc="@message.SentAtUtc.ToString("yyyy-MM-ddTHH:mm:ss")Z"></span></div>
            <div class="chat-bubble">@message.Text</div>
        </div>
    }
</div>

@if (Model.CanSend)
{
    <form id="chat-form" class="d-flex gap-2">
        <input id="chat-input" class="form-control" maxlength="2000" autocomplete="off" placeholder="Write a message..." />
        <button type="submit" class="btn btn-primary">Send</button>
    </form>
}
else
{
    <div class="alert alert-secondary mb-0">This partnership is completed, so the chat is read-only.</div>
}
<div id="chat-status" class="small text-secondary mt-1">Connecting...</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        (function () {
            const applicationId = @Model.Application.Id;
            const myOrganizationId = @Model.Me.Id;
            const list = document.getElementById("messages");
            const form = document.getElementById("chat-form");
            const input = document.getElementById("chat-input");
            const status = document.getElementById("chat-status");

            function toLocal(value) {
                const text = String(value);
                const hasZone = /Z$|[+-][0-9]{2}:[0-9]{2}$/.test(text);
                return new Date(hasZone ? text : text + "Z").toLocaleString([], { dateStyle: "medium", timeStyle: "short" });
            }

            function scrollDown() { list.scrollTop = list.scrollHeight; }

            document.querySelectorAll("[data-utc]").forEach(function (el) {
                el.textContent = toLocal(el.dataset.utc);
            });
            scrollDown();

            function append(message) {
                const mine = message.senderOrganizationId === myOrganizationId;
                const wrapper = document.createElement("div");
                wrapper.className = "chat-message " + (mine ? "mine" : "theirs");

                const meta = document.createElement("div");
                meta.className = "chat-meta";
                meta.textContent = message.senderName + " - " + toLocal(message.sentAtUtc);

                const bubble = document.createElement("div");
                bubble.className = "chat-bubble";
                bubble.textContent = message.text;

                wrapper.appendChild(meta);
                wrapper.appendChild(bubble);
                list.appendChild(wrapper);
                scrollDown();
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/chat")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", append);
            connection.onreconnecting(function () { status.textContent = "Reconnecting..."; });
            connection.onreconnected(function () {
                connection.invoke("Join", applicationId);
                status.textContent = "Connected";
            });

            connection.start()
                .then(function () { return connection.invoke("Join", applicationId); })
                .then(function () { status.textContent = "Connected - messages arrive live."; })
                .catch(function (err) { status.textContent = "Could not connect: " + err.message; });

            if (form) {
                form.addEventListener("submit", function (event) {
                    event.preventDefault();
                    const text = input.value.trim();
                    if (!text) { return; }
                    input.value = "";
                    connection.invoke("Send", applicationId, text).catch(function (err) {
                        status.textContent = err.message;
                        input.value = text;
                    });
                });
            }
        })();
    </script>
}
