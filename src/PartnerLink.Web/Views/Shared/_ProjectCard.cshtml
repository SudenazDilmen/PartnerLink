@model ProjectCard
@{
    var daysLeft = (Model.PartnerSearchEnd.Date - DateTime.UtcNow.Date).Days;
    var daysText = daysLeft <= 0 ? "last day" : daysLeft + " days left";
}
<div class="card project-card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
            <div>
                <a asp-controller="Organizations" asp-action="Details" asp-route-id="@Model.OrganizationId" class="fw-semibold text-decoration-none">@Model.OrganizationName</a>
                <partial name="_VerifiedBadge" model="Model.OrganizationVerified" />
                <div class="small text-secondary">@Model.OrganizationCountry &middot; <partial name="_Trust" model="Model.OrganizationTrust" /></div>
            </div>
            <span class="badge @(daysLeft <= 7 ? "text-bg-danger" : "text-bg-light border") flex-shrink-0">@daysText</span>
        </div>

        <h2 class="h5">@Model.Title</h2>
        <p class="text-secondary small mb-3">@Model.Summary</p>

        <div class="mb-3 d-flex flex-wrap gap-1">
            <span class="badge text-bg-dark">@Model.ActionType.Label()</span>
            <span class="badge text-bg-primary">@Model.Sector.Label()</span>
            @foreach (var priority in EnumFlags.Split(Model.Priorities))
            {
                <span class="badge text-bg-success">@priority.Label()</span>
            }
        </div>

        <div class="small text-secondary mb-3">Looking for: @CountryList.Describe(Model.TargetCountries)</div>

        <div class="mt-auto">
            <a class="btn btn-primary btn-sm" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Id">View details</a>
        </div>
    </div>
</div>
