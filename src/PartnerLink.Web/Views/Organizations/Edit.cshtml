@model OrganizationFormViewModel
@{
    ViewData["Title"] = "My organization";
}

<h1 class="h3 mb-3">My organization</h1>

<div class="card" style="max-width: 820px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_OrganizationFields" model="Model" />
            <div class="alert alert-info small">Changing your OID sends your organization back to verification.</div>
            <button type="submit" class="btn btn-primary">Save profile</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
