@model IReadOnlyList<PartnerApplication>
@{
    ViewData["Title"] = "Incoming applications";
}

<h1 class="h3 mb-3">Incoming applications</h1>

@if (Model.Count == 0)
{
    <div class="card card-body text-center text-secondary py-5">
        Nobody has applied to your projects yet.
    </div>
}

<div class="vstack gap-3">
    @foreach (var application in Model)
    {
        var applicant = application.Applicant!;
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <a asp-controller="Organizations" asp-action="Details" asp-route-id="@applicant.Id" class="h5 text-decoration-none">@applicant.Name</a>
                        <partial name="_VerifiedBadge" model="@(applicant.Verification == VerificationStatus.Verified)" />
                        <div class="small text-secondary">
                            @applicant.City, @applicant.Country &middot; <partial name="_Trust" model="applicant.TrustScore" />
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge @(application.Status == ApplicationStatus.Pending ? "text-bg-warning" : application.Status == ApplicationStatus.Rejected ? "text-bg-secondary" : "text-bg-success")">@application.Status</span>
                        <div class="small text-secondary">@application.CreatedAtUtc.ToString("MMM d, yyyy")</div>
                    </div>
                </div>

                <div class="small text-secondary mt-2">
                    For project: <a asp-controller="Projects" asp-action="Details" asp-route-id="@application.ProjectId">@application.Project!.Title</a>
                </div>
                <p class="mt-2 mb-3" style="white-space: pre-line">@application.Message</p>

                @if (application.Status == ApplicationStatus.Pending)
                {
                    <div class="d-flex gap-2">
                        <form asp-action="Respond" method="post">
                            <input type="hidden" name="id" value="@application.Id" />
                            <input type="hidden" name="accept" value="true" />
                            <button type="submit" class="btn btn-primary">Accept &amp; start chat</button>
                        </form>
                        <form asp-action="Respond" method="post">
                            <input type="hidden" name="id" value="@application.Id" />
                            <input type="hidden" name="accept" value="false" />
                            <button type="submit" class="btn btn-outline-secondary">Decline</button>
                        </form>
                    </div>
                }
                else if (application.Status is ApplicationStatus.Accepted or ApplicationStatus.Completed)
                {
                    <a class="btn btn-outline-primary" asp-controller="Chat" asp-action="Room" asp-route-id="@application.Id">Open chat</a>
                }
            </div>
        </div>
    }
</div>
