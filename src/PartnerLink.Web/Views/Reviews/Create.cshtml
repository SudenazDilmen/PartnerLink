@model ReviewFormViewModel
@{
    ViewData["Title"] = "Review " + Model.OtherOrganizationName;
}

<h1 class="h3 mb-1">Review @Model.OtherOrganizationName</h1>
<p class="text-secondary">Project: @Model.ProjectTitle. Your honest feedback builds the trust score that other organizations see.</p>

<div class="card" style="max-width: 640px;">
    <div class="card-body">
        <form asp-action="Create" asp-route-id="@Model.ApplicationId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ApplicationId" />

            <div class="mb-3">
                <label asp-for="Communication" class="form-label"></label>
                <select asp-for="Communication" class="form-select">
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Okay</option>
                    <option value="2">2 - Poor</option>
                    <option value="1">1 - Very poor</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="TaskManagement" class="form-label"></label>
                <select asp-for="TaskManagement" class="form-select">
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Okay</option>
                    <option value="2">2 - Poor</option>
                    <option value="1">1 - Very poor</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Reporting" class="form-label"></label>
                <select asp-for="Reporting" class="form-select">
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Okay</option>
                    <option value="2">2 - Poor</option>
                    <option value="1">1 - Very poor</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Comment" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Submit review</button>
                <a class="btn btn-outline-secondary" asp-controller="Chat" asp-action="Room" asp-route-id="@Model.ApplicationId">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
